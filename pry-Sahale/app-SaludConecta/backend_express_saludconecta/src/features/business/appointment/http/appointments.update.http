### Feature Appointment — UPDATE (PUT) / UPDATE (PATCH)
### Leyenda: JWT + RBAC (login como admin + Authorization: Bearer)
@baseUrl = http://localhost:4000

# @name loginAdmin
POST {{baseUrl}}/api/session/login
Content-Type: application/json

{
  "identifier": "admin",
  "password": "Admin123!"
}

@token = {{loginAdmin.response.body.$.access_token}}

###
@id = 1

# @name updateAppointmentPut
PUT {{baseUrl}}/api/appointments/{{id}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "agenda_id": 1,
  "patient_id": 1,
  "start_date": "2026-10-05T09:00:00",
  "end_date": "2026-10-05T09:30:00",
  "reason": "Consulta de control (reprogramada)",
  "state": "scheduled",
  "status": "active"
}

###

# @name updateAppointmentPatch
PATCH {{baseUrl}}/api/appointments/{{id}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "state": "cancelled"
}
