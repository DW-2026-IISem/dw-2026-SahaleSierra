### Feature Patient — UPDATE (PUT) / UPDATE (PATCH)
### Leyenda: JWT + RBAC (login como admin + Authorization: Bearer)
@baseUrl = http://localhost:4000

# @name loginAdmin
POST {{baseUrl}}/api/session/login
Content-Type: application/json

{
  "identifier": "admin",
  "password": "Admin123!"
}

@token = {{loginAdmin.response.body.$.access_token}}

###
@id = 1

# @name updatePatientPut
PUT {{baseUrl}}/api/patients/{{id}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "document_type": "CC",
  "document_number": "1001234567",
  "name": "Ana Pérez Actualizada",
  "birth_date": "1992-03-15",
  "contact": "3009876543",
  "status": "active"
}

###

# @name updatePatientPatch
PATCH {{baseUrl}}/api/patients/{{id}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "contact": "3011112233"
}
