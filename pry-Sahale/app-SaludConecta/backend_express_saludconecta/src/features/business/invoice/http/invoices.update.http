### Feature Invoice — UPDATE (PUT) / UPDATE (PATCH)
### Leyenda: JWT + RBAC (login como admin + Authorization: Bearer)
@baseUrl = http://localhost:4000

# @name loginAdmin
POST {{baseUrl}}/api/session/login
Content-Type: application/json

{
  "identifier": "admin",
  "password": "Admin123!"
}

@token = {{loginAdmin.response.body.$.access_token}}

###
@id = 1

# @name updateInvoicePut
PUT {{baseUrl}}/api/invoices/{{id}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "number": "FV-100001",
  "invoice_date": "2026-10-06T10:00:00",
  "tax": 2000,
  "state": "issued",
  "status": "active"
}

###

# @name updateInvoicePatch
PATCH {{baseUrl}}/api/invoices/{{id}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "state": "paid"
}
