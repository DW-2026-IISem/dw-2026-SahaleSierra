### Feature DoctorSpecialty — UPDATE (PUT) / UPDATE (PATCH)
### Leyenda: JWT + RBAC (login como admin + Authorization: Bearer)
@baseUrl = http://localhost:4000

# @name loginAdmin
POST {{baseUrl}}/api/session/login
Content-Type: application/json

{
  "identifier": "admin",
  "password": "Admin123!"
}

@token = {{loginAdmin.response.body.$.access_token}}

###
@id = 1

# @name updateDoctorSpecialtyPut
PUT {{baseUrl}}/api/doctor-specialties/{{id}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "relation_data": "Especialidad secundaria",
  "status": "active"
}

###

# @name updateDoctorSpecialtyPatch
PATCH {{baseUrl}}/api/doctor-specialties/{{id}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "relation_data": "Atiende martes y jueves"
}
