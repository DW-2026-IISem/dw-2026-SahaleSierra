### Feature Agenda — UPDATE (PUT) / UPDATE (PATCH)
### Leyenda: JWT + RBAC (login como admin + Authorization: Bearer)
@baseUrl = http://localhost:4000

# @name loginAdmin
POST {{baseUrl}}/api/session/login
Content-Type: application/json

{
  "identifier": "admin",
  "password": "Admin123!"
}

@token = {{loginAdmin.response.body.$.access_token}}

###
@id = 1

# @name updateAgendaPut
PUT {{baseUrl}}/api/agendas/{{id}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Agenda Tarde — Dr. Carlos Gómez",
  "description": "Lunes a viernes, jornada de la tarde",
  "doctor_id": 1,
  "status": "active"
}

###

# @name updateAgendaPatch
PATCH {{baseUrl}}/api/agendas/{{id}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "description": "Martes y jueves, jornada de la mañana"
}
