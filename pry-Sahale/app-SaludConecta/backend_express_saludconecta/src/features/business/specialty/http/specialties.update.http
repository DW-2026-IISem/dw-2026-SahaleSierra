### Feature Specialty — UPDATE (PUT) / UPDATE (PATCH)
### Leyenda: JWT + RBAC (login como admin + Authorization: Bearer)
@baseUrl = http://localhost:4000

# @name loginAdmin
POST {{baseUrl}}/api/session/login
Content-Type: application/json

{
  "identifier": "admin",
  "password": "Admin123!"
}

@token = {{loginAdmin.response.body.$.access_token}}

###
@id = 1

# @name updateSpecialtyPut
PUT {{baseUrl}}/api/specialties/{{id}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Cardiología Clínica",
  "description": "Consulta ambulatoria de cardiología",
  "status": "active"
}

###

# @name updateSpecialtyPatch
PATCH {{baseUrl}}/api/specialties/{{id}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "description": "Descripción parcial"
}
