### Feature Service — UPDATE (PUT) / UPDATE (PATCH)
### Leyenda: JWT + RBAC (login como admin + Authorization: Bearer)
@baseUrl = http://localhost:4000

# @name loginAdmin
POST {{baseUrl}}/api/session/login
Content-Type: application/json

{
  "identifier": "admin",
  "password": "Admin123!"
}

@token = {{loginAdmin.response.body.$.access_token}}

###
@id = 1

# @name updateServicePut
PUT {{baseUrl}}/api/services/{{id}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Consulta de medicina general (control)",
  "description": "Consulta ambulatoria de control",
  "status": "active"
}

###

# @name updateServicePatch
PATCH {{baseUrl}}/api/services/{{id}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "description": "Descripción parcial"
}
